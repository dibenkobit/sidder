{
  "name": "siddy",
  "version": "0.0.1",
  "description": "A seed runner. Migrations got one fifteen years ago; seeds never did.",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "license": "MIT",
  "author": "Nikita Snetkov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dibenkobit/siddy.git"
  },
  "homepage": "https://github.com/dibenkobit/siddy#readme",
  "bugs": "https://github.com/dibenkobit/siddy/issues",
  "keywords": [
    "seed",
    "seeds",
    "seeding",
    "database",
    "postgres",
    "drizzle",
    "prisma",
    "fixtures",
    "migrations",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "siddy": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "default": "./dist/adapters/drizzle.js"
    },
    "./adapters/pg": {
      "types": "./dist/adapters/pg.d.ts",
      "default": "./dist/adapters/pg.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:pg": "SIDDY_TEST_DATABASE_URL=postgresql://siddy:siddy@localhost:55432/siddy bun test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "check": "bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "drizzle-orm": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.3",
    "typescript": "^5.9.3"
  }
}
